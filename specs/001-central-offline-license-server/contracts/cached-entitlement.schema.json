{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offline-license.example/schemas/cached-entitlement-1.0.json",
  "title": "Cached Entitlement Payload 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "certificateId",
    "licenseId",
    "licenseServerId",
    "instanceId",
    "instancePublicKeyFingerprint",
    "issuedAt",
    "expiresAt",
    "products",
    "offlinePolicy"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "certificateId": { "type": "string", "format": "uuid" },
    "licenseId": { "type": "string", "minLength": 1 },
    "licenseServerId": { "type": "string", "format": "uuid" },
    "instanceId": { "type": "string", "format": "uuid" },
    "instancePublicKeyFingerprint": { "type": "string", "minLength": 43, "maxLength": 43 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "features"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
          "features": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" }
          }
        }
      }
    },
    "offlinePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedOperations", "offlineAeuAllowance"],
      "properties": {
        "allowedOperations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["PRODUCT_CHECK", "FEATURE_CHECK", "EXISTING_PRODUCT_OPERATION"] }
        },
        "offlineAeuAllowance": { "const": 0 }
      }
    }
  }
}
